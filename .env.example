# Copy to .env and fill in the values. Keep .env private and out of version control.

# Discord bot token; required.
Discord__Token=replace-with-discord-bot-token

# Optional. Set a server ID for immediate server-specific command registration.
# Leave empty to register globally, instead of using the local appsettings example.
Discord__GuildId=

# Dedicated Heart of Daggers account and its IMAP mailbox, used for campaign
# notifications. The account must already be activated. Leave these empty if you
# are not using Heart of Daggers campaigns.
HeartOfDaggers__Email=bot@example.com
HeartOfDaggers__Imap__Host=imap.example.com
HeartOfDaggers__Imap__Port=993
HeartOfDaggers__Imap__Username=bot@example.com
HeartOfDaggers__Imap__Password='replace-with-imap-password'

# Optional: override the comma-separated accepted login-email sender addresses.
# HeartOfDaggers__Imap__Sender=noreply@heartofdaggers.com,noreply@8510680.brevosend.com

# PokéAPI data is cloned or updated automatically in the persistent volume.
# Set this to false to use the existing checkout without fetching updates.
# PokeApi__AutoUpdate=false

# Optional: override the image name, for example for a fork or a local build.
# BOT_IMAGE=ghcr.io/calico-crusade/dnd-sharp:latest

# Optional: use HeartOfDaggers__Cookie instead of email/IMAP. Leave the email
# empty in that case. The cookie must include its name and value.
# HeartOfDaggers__Cookie='wordpress_logged_in_...=...'

# Optional: a custom font or legacy subscription JSON path inside the container.
# Mount those files before enabling these settings.
# Discord__CardFontPath=/opt/fonts/custom.ttf
# Discord__CampaignSubscriptionsPath=/var/lib/dndsharp/campaign-subscriptions.json

# The Compose example fixes Discord__DatabasePath, HeartOfDaggers__SessionPath,
# and PokeApi__BasePath inside its volumes. Change the Compose file and mounts
# together if you need different container paths.
