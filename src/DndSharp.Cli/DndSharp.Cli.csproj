<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>617cb7fb-359d-4946-92af-956e806a6280</UserSecretsId>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BotOnly)' == 'true'">
    <DefineConstants>$(DefineConstants);BOT_ONLY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CardboardBox.Http" Version="4.0.0" />
    <PackageReference Include="CardboardBox.Http.Files" Version="4.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" Condition="'$(BotOnly)' != 'true'" />
    <PackageReference Include="Spectre.Console.ImageSharp" Version="0.57.2" Condition="'$(BotOnly)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(BotOnly)' == 'true'">
    <Compile Remove="Verbs\PrintPokemonVerb.cs;Verbs\GenStatsVerb.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DndSharp.Pokemon\DndSharp.Pokemon.csproj" />
    <ProjectReference Include="..\DndSharp.Discord\DndSharp.Discord.csproj" />
    <ProjectReference Include="..\DndSharp.HeartOfDaggers\DndSharp.HeartOfDaggers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
